#!/usr/bin/env bash
# HWDT: every commit must reference a Jira issue:  "HWDT-123: description"
msg="$(head -n1 "$1")"
if [[ "$msg" =~ ^HWDT-[0-9]+:\ .{5,} ]] || [[ "$msg" =~ ^(Merge|Revert) ]]; then
  exit 0
fi
echo "ERROR: commit message must start with a Jira key, e.g. 'HWDT-13: add credential CRUD API'" >&2
echo "       got: $msg" >&2
exit 1
