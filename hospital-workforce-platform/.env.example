# =============================================================================
# Hospital Workforce Digital Twin — PHASE 0 environment template
# Copy to .env and replace every "change_me" value:   cp .env.example .env
# Generate strong secrets with:   ./scripts/generate_env.sh   (creates .env)
# NEVER commit .env — it is excluded by .gitignore.
# =============================================================================

# ---- General -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=hwdt
TZ=UTC

# ---- Image versions (pinned for reproducibility) ------------------------------
POSTGRES_VERSION=15
JIRA_VERSION=10.3
CONFLUENCE_VERSION=9.2
NGINX_VERSION=1.27
PROMETHEUS_VERSION=v2.54.1
CADVISOR_VERSION=v0.49.1
NODE_EXPORTER_VERSION=v1.8.2

# ---- PostgreSQL superuser (used only for init + backups) ---------------------
POSTGRES_SUPERUSER=hwdt_admin
POSTGRES_SUPERUSER_PASSWORD=change_me_superuser_password

# ---- Jira database -------------------------------------------------------------
JIRA_DB_NAME=jira_db
JIRA_DB_USER=jira_user
JIRA_DB_PASSWORD=change_me_jira_db_password

# ---- Confluence database -------------------------------------------------------
CONFLUENCE_DB_NAME=confluence_db
CONFLUENCE_DB_USER=confluence_user
CONFLUENCE_DB_PASSWORD=change_me_confluence_db_password
# Collation required by Confluence. Falls back to C.UTF-8 if unavailable.
CONFLUENCE_DB_LOCALE=en_US.UTF-8

# ---- Public hostnames / reverse proxy ------------------------------------------
JIRA_HOSTNAME=jira.local
CONFLUENCE_HOSTNAME=confluence.local
MONITORING_HOSTNAME=monitoring.local
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Values Tomcat uses to build absolute URLs (switch to https/443/true after enabling SSL)
PUBLIC_SCHEME=http
PUBLIC_HTTP_PORT=80
PUBLIC_SECURE=false

# ---- JVM sizing ------------------------------------------------------------------
JIRA_JVM_MIN=1024m
JIRA_JVM_MAX=2048m
CONFLUENCE_JVM_MIN=1024m
CONFLUENCE_JVM_MAX=2048m

# ---- Atlassian licences / admin (used by the provisioner) -----------------------
# Optional: Confluence licence key (trial keys from https://my.atlassian.com)
CONFLUENCE_LICENSE_KEY=
JIRA_ADMIN_USER=admin
JIRA_ADMIN_PASSWORD=change_me_jira_admin_password
CONFLUENCE_ADMIN_USER=admin
CONFLUENCE_ADMIN_PASSWORD=change_me_confluence_admin_password

# ---- Phase 1: Workforce application (backend + frontend) --------------------------
HWDT_VERSION=1.0.0
HWDT_HOSTNAME=hwdt.local
HWDT_DB_NAME=hwdt_db
HWDT_DB_USER=hwdt_app
HWDT_DB_PASSWORD=change_me_hwdt_db_password
# >= 32 random characters (scripts/generate_env.sh generates one)
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRES_IN_SECONDS=3600
# Demo data + demo users (disable in shared environments)
HWDT_SEED_DEMO=true
# Leave empty to use the documented demo password; set to override (>= 10 chars)
HWDT_SEED_PASSWORD=
# Optional bootstrap admin when HWDT_SEED_DEMO=false
HWDT_ADMIN_EMAIL=
HWDT_ADMIN_PASSWORD=change_me_admin_password

# ---- Backup service ----------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7

# ---- Monitoring ----------------------------------------------------------------------
PROMETHEUS_RETENTION=15d
