{
  "name": "hwdt-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HWDT Phase 1 backend: Node.js + Express + TypeScript (modular monolith, microservice-ready)",
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "migrate": "node --import tsx src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "8.20.0",
    "tsx": "^4.20.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "typescript": "5.9.3"
  }
}
